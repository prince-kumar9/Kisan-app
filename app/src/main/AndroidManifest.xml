<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet Permission for Backend API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="KisanApp"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KisanApp"
        android:usesCleartextTraffic="true">

        <!-- Login -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Register -->
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />

        <!-- Dashboard -->
        <activity
            android:name=".dashboard.DashboardActivity"
            android:exported="false" />

        <!-- Crop Entry -->
        <activity
            android:name=".crops.CropEntryActivity"
            android:exported="false" />

        <!-- Crop Analysis -->
        <activity
            android:name=".analysis.CropAnalysisActivity"
            android:exported="false" />

        <!-- Marketplace -->
        <activity
            android:name=".marketplace.MarketplaceActivity"
            android:exported="false" />

        <!-- Farmer Profile -->
        <activity
            android:name=".profile.FarmerProfileActivity"
            android:exported="false" />

    </application>

</manifest>
