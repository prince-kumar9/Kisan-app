<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="50dp"
        android:paddingBottom="20dp">

        <!-- ============================================= -->
        <!-- HEADER -->
        <!-- ============================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kisan Marketplace"
            android:textColor="#1B5E20"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect directly with farmers and buyers"
            android:textColor="#607D66"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <!-- ============================================= -->
        <!-- BUY / SELL BUTTONS -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnBuy"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Buy Crops"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#2E7D32" />

            <Button
                android:id="@+id/btnSell"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Sell Crops"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:backgroundTint="#2E7D32" />

        </LinearLayout>

        <!-- ============================================= -->
        <!-- TITLE -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/tvMarketplaceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buy Crops"
            android:textColor="#1B5E20"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- ============================================= -->
        <!-- INFO -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/tvMarketplaceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explore crop listings from farmers."
            android:textColor="#455A49"
            android:textSize="15sp"
            android:layout_marginBottom="16dp" />

        <!-- ============================================= -->
        <!-- DYNAMIC CONTENT -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/layoutMarketplaceContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp" />

        <!-- ============================================= -->
        <!-- BACK BUTTON -->
        <!-- ============================================= -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="#1B5E20"
            android:textSize="15sp"
            android:backgroundTint="#DDEBDD" />

    </LinearLayout>

</ScrollView>