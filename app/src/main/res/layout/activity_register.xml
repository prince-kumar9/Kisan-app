<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRegister"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fadeScrollbars="false"
    android:overScrollMode="always"
    android:background="#F3F8F1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="22dp">

        <!-- LOGO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌾"
            android:textSize="48sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="#245C32"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join KisanApp and grow together"
            android:textColor="#667568"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- NAME -->
        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#39834A" />

        <!-- MOBILE -->
        <EditText
            android:id="@+id/etMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:hint="Mobile Number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#39834A" />

        <!-- EMAIL -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#39834A" />

        <!-- PASSWORD -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:hint="Password (minimum 6 characters)"
            android:inputType="textPassword"
            android:padding="14dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#39834A" />

        <!-- LOCATION TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Location"
            android:textColor="#245C32"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- ================= STATE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="State"
            android:textColor="#245C32"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <Spinner
                android:id="@+id/spinnerState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spinner_box"
                android:paddingStart="12dp"
                android:paddingEnd="40dp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="▼"
                android:textColor="#236B36"
                android:textSize="14sp"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <!-- ================= DISTRICT ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="District"
            android:textColor="#245C32"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <Spinner
                android:id="@+id/spinnerDistrict"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spinner_box"
                android:paddingStart="12dp"
                android:paddingEnd="40dp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="▼"
                android:textColor="#236B36"
                android:textSize="14sp"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <!-- ================= BLOCK ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Block"
            android:textColor="#245C32"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp">

            <Spinner
                android:id="@+id/spinnerBlock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spinner_box"
                android:paddingStart="12dp"
                android:paddingEnd="40dp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="▼"
                android:textColor="#236B36"
                android:textSize="14sp"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <!-- ================= PANCHAYAT ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Panchayat"
            android:textColor="#245C32"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp">

            <Spinner
                android:id="@+id/spinnerPanchayat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_spinner_box"
                android:paddingStart="12dp"
                android:paddingEnd="40dp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center"
                android:text="▼"
                android:textColor="#236B36"
                android:textSize="14sp"
                android:clickable="false"
                android:focusable="false" />

        </FrameLayout>

        <!-- REGISTER BUTTON -->

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Create Account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#287A3D"
            android:layout_marginBottom="16dp" />

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By creating an account, you agree to use KisanApp responsibly."
            android:textColor="#667568"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>