<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F2"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="28dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, Farmer!"
            android:textColor="#1B5E20"
            android:textSize="26sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvFarmerDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Farmer details"
            android:textColor="#333333"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location"
            android:textColor="#555555"
            android:textSize="14sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Crops"
            android:textColor="#1B5E20"
            android:textSize="22sp"
            android:textStyle="bold"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvCropSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E5F3E5"
            android:padding="16dp"
            android:text="Your crop summary will appear here"
            android:textColor="#24452A"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/layoutDashboardCrops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="4dp" />

        <!-- Add / Manage Crops -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#DDF3DD"
            android:orientation="vertical"
            android:padding="6dp">

            <Button
                android:id="@+id/btnAddCrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E9B50"
                android:minHeight="64dp"
                android:text="🌱  Add / Manage Crops  ›"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Crop Analysis -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#DDEEFF"
            android:orientation="vertical"
            android:padding="6dp">

            <Button
                android:id="@+id/btnCropAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2785D8"
                android:minHeight="64dp"
                android:text="📊  Crop Analysis  ›"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Marketing Buy / Sell -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFEDD9"
            android:orientation="vertical"
            android:padding="6dp">

            <Button
                android:id="@+id/btnMarketing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#F58B24"
                android:minHeight="64dp"
                android:text="🛒  Marketing (Buy / Sell)  ›"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- My Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EAE1FF"
            android:orientation="vertical"
            android:padding="6dp">

            <Button
                android:id="@+id/btnMyAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#8055C9"
                android:minHeight="64dp"
                android:text="👤  My Account  ›"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Logout -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#E95757"
            android:minHeight="56dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>