<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F8F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌾 Add Your Crop"
            android:textColor="#1B5E20"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter crop, cultivated area and crop duration"
            android:textColor="#607D66"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- SEASON -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Season"
            android:textColor="#263A2B"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinnerSeason"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_spinner_box"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- CROP NAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crop Name"
            android:textColor="#263A2B"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinnerCrop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_spinner_box"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <EditText
            android:id="@+id/etOtherCrop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:hint="Enter your crop name"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:textColor="#263A2B"
            android:textColorHint="#8A9B8D"
            android:background="@drawable/bg_spinner_box"
            android:visibility="gone" />

        <!-- CULTIVATED AREA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cultivated Area"
            android:textColor="#263A2B"
            android:textStyle="bold"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/etArea"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:hint="Enter area"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:background="@drawable/bg_spinner_box"
                android:textColor="#263A2B"
                android:textColorHint="#8A9B8D" />

            <Spinner
                android:id="@+id/spinnerAreaUnit"
                android:layout_width="120dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_spinner_box"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

        <!-- START DATE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crop Start Date"
            android:textColor="#263A2B"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etStartDate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:hint="Select start date"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:background="@drawable/bg_spinner_box"
            android:textColor="#263A2B"
            android:textColorHint="#8A9B8D"
            android:contentDescription="Select crop start date" />

        <!-- END DATE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crop End Date"
            android:textColor="#263A2B"
            android:textStyle="bold"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etEndDate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:hint="Select end date"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:inputType="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:background="@drawable/bg_spinner_box"
            android:textColor="#263A2B"
            android:textColorHint="#8A9B8D"
            android:contentDescription="Select crop end date" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose dates between 2026 and 2050"
            android:textColor="#607D66"
            android:textSize="12sp"
            android:layout_marginBottom="22dp" />

        <!-- ADD / UPDATE BUTTON -->

        <Button
            android:id="@+id/btnSaveCrop"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="ADD CROP"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

        <!-- CROP LIST HEADING -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Added Crops"
            android:textColor="#1B5E20"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp" />

        <!-- DYNAMIC CROP CARDS -->

        <LinearLayout
            android:id="@+id/layoutCropList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- BACK BUTTON -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="Back to Dashboard"
            android:textAllCaps="false"
            android:textColor="#1B5E20"
            android:backgroundTint="#DDEBDD" />

    </LinearLayout>

</ScrollView>
